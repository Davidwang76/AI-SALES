{
  "name": "ai-sales",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/api/server.ts",
    "start": "node --env-file-if-exists=.env --use-env-proxy --import tsx apps/api/server.ts",
    "worker": "node --env-file-if-exists=.env --use-env-proxy --import tsx apps/api/worker.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/db/seed.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.8",
    "decimal.js": "10.6.0",
    "fastify": "5.12.7",
    "lucide-react": "1.62.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
