DATABASE_URL=postgres://sales:sales_dev_only@127.0.0.1:5432/sales
PORT=3000
HOST=127.0.0.1
STORAGE_DIR=.local/files
# 首次初始化必须设置；不要在生产使用演示账号
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ENTITY=我的经营主体
# 可选；模型不会自动获得搜索/发信权限
MODEL_API_KEY=
MODEL_NAME=
MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
# Compose部署变量（脚本自动生成强随机DB密码）
DB_PASSWORD=
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
COOKIE_SECURE=true
